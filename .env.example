# --- Database -------------------------------------------------------------
# Connection string MongoDB (Atlas atau lokal).
# OPSIONAL untuk situs publik (ada fallback data statis), tetapi WAJIB
# untuk auth, wallet, checkout, dan panel admin.
MONGODB_URI=mongodb://127.0.0.1:27017/topinzpedia
MONGODB_DB=topinzpedia

# --- Auth (Auth.js) ---------------------------------------------------------
# WAJIB. Generate dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-random-32-byte
# Set "true" bila deploy di luar Vercel (mis. Railway/VPS/Docker)
AUTH_TRUST_HOST=true
# Disarankan diisi saat deploy di VPS/reverse proxy:
# AUTH_URL=https://topinzpedia.my.id

# Opsional — Login dengan Google (aktifkan juga dari Admin > Pengaturan)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# Password akun admin yang dibuat oleh `npm run seed`
SEED_ADMIN_PASSWORD=admin12345

# --- Email / SMTP (verifikasi akun & reset password) -------------------------
# Bila TIDAK diisi: akun baru otomatis terverifikasi & reset password nonaktif.
# Contoh Gmail: host smtp.gmail.com, port 587, pass = App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=kamu@gmail.com
# SMTP_PASS=app-password-16-digit
# EMAIL_FROM="TopinzPedia <no-reply@topinzpedia.my.id>"

# --- Site -----------------------------------------------------------------
# URL publik situs — dipakai untuk metadata SEO, sitemap, dan OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nomor WhatsApp admin (format internasional tanpa tanda +).
NEXT_PUBLIC_WHATSAPP=6281234567890
