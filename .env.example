# --- Database -------------------------------------------------------------
# Connection string MongoDB (Atlas atau lokal).
# OPSIONAL: bila dikosongkan, website berjalan dalam mode demo
# menggunakan data statis bawaan (lib/data/fallback-data.ts).
MONGODB_URI=mongodb://127.0.0.1:27017/topinzpedia
MONGODB_DB=topinzpedia

# --- Site -----------------------------------------------------------------
# URL publik situs — dipakai untuk metadata SEO, sitemap, dan OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nomor WhatsApp admin (format internasional tanpa tanda +).
NEXT_PUBLIC_WHATSAPP=6281234567890

# --- Admin ------------------------------------------------------------------
# Kunci akses panel admin (/admin). WAJIB diganti dengan nilai rahasia
# yang kuat sebelum deploy. Bila kosong, panel admin terkunci.
ADMIN_KEY=ganti-dengan-kunci-rahasia
