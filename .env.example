# --- Database -------------------------------------------------------------
# Connection string MongoDB (Atlas atau lokal).
# OPSIONAL untuk situs publik (ada fallback data statis), tetapi WAJIB
# untuk auth, wallet, checkout, dan panel admin.
MONGODB_URI=mongodb://127.0.0.1:27017/topinzpedia
MONGODB_DB=topinzpedia

# --- Auth (Auth.js) ---------------------------------------------------------
# WAJIB. Generate dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-random-32-byte
# Set "true" bila deploy di luar Vercel (mis. Railway/VPS/Docker)
AUTH_TRUST_HOST=true
# Disarankan diisi saat deploy di VPS/reverse proxy:
# AUTH_URL=https://topinzpedia.my.id

# Opsional — Login dengan Google (aktifkan juga dari Admin > Pengaturan)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# Password akun admin yang dibuat oleh `npm run seed`
SEED_ADMIN_PASSWORD=admin12345

# --- Email / Resend (verifikasi akun, reset password, notifikasi) -----------
# Dapatkan API key di https://resend.com -> API Keys.
# GANTI placeholder di bawah dengan API key Resend milikmu sendiri!
# Bila kosong: email dilewati (log "Resend belum dikonfigurasi."),
# akun baru auto-verified, reset password nonaktif.
RESEND_API_KEY=re_xxxxxxxxx
DEFAULT_EMAIL_FROM=no-reply@topinzpedia.my.id
SUPPORT_EMAIL=support@topinzpedia.my.id

# --- Captcha / Cloudflare Turnstile (opsional) -------------------------------
# Bawaan memakai captcha matematika (tanpa setup). Untuk Turnstile,
# atur dari Admin > Pengaturan > Captcha, ATAU isi env di bawah sebagai default.
# Site key aman publik; secret key HARUS rahasia.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Cloudinary (penyimpanan gambar production) ------------------------------
# WAJIB untuk production (Railway/VPS): semua upload gambar (logo, banner,
# bukti transfer, QRIS, avatar) tersimpan di Cloudinary CDN.
# Bila kosong: fallback penyimpanan lokal public/uploads (hanya untuk dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site -----------------------------------------------------------------
# URL publik situs — dipakai untuk metadata SEO, sitemap, dan OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nomor WhatsApp admin (format internasional tanpa tanda +).
NEXT_PUBLIC_WHATSAPP=6281234567890
